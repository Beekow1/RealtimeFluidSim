      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_SOLVER_GPU": "GPU",
        "RFS_CUDA_ARCHITECTURES": "86"
      }
    },

    {
      "name": "macos-debug-cpu",
      "displayName": "macOS Debug CPU",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USE_SOLVER_GPU": "CPU"
      }
    },
    {
      "name": "macos-release-cpu",
